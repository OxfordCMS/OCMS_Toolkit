# Download sequencing runs from ENA and verify the downloads with MD5 checksums
"""
pipeline_sra.smk
================

Parses the download script generated by the ENA Browser ("Download all"),
runs each download as a separate job, and checks every downloaded file with
MD5 checksums.

Downloads need internet access, so they run on the node from which the
pipeline is launched rather than as Slurm jobs. The number of downloads run
at the same time is ``download.max_parallel`` in the configuration file.

Usage
-----

From the directory in which the downloads should be written::

    ocms_toolkit sra config            # write pipeline_sra.yaml
    ocms_toolkit sra full --dry        # show the jobs that would run
    ocms_toolkit sra full --jobs 20    # download and verify

To delete the downloaded files after they have been checked (for example once
they have been copied elsewhere), run the optional ``clean_up`` step::

    ocms_toolkit sra full -- clean_up

Running ``full`` again afterwards does not download the files again, because
the checksum report is up to date. To download them again, run::

    ocms_toolkit sra full -- --forcerun ena_download

Input
-----

``ena_script``: the download script from the ENA Browser. Each line is a
``wget`` (or similar) command ending in the URL of one file.

Output
------

``downloaded.dir/<file>``
    downloaded files;
``downloaded.dir/.sentinel.<file>``
    time at which each file was downloaded;
``checksums.dir/<file>.md5``, ``checksums.dir/.sentinel.<file>.md5``
    MD5 checksum of each file and the result of checking it;
``checksums.dir/report.txt``, ``checksums.dir/failed_check_sums.txt``
    results of all checks, and the files that failed (if any);
``README.md``
    record of the BioProject, the download date, the files downloaded and the
    checksum results.
"""

from datetime import datetime
from pathlib import Path

from snakemake.exceptions import WorkflowError

from ocmstoolkit.modules import Sra as SRA
from ocmstoolkit.modules import Workflow as W

BIOPROJECT = config.get("bioproject") or "not specified"
ENA_SCRIPT = config.get("ena_script")
DOWNLOAD = config.get("download") or {}
CHECKSUMS = config.get("checksums") or {}

try:
    if not ENA_SCRIPT:
        raise ValueError(
            "set ena_script to the download script from the ENA Browser.")
    if not Path(ENA_SCRIPT).is_file():
        raise ValueError(f"ena_script '{ENA_SCRIPT}' not found.")
    # downloaded file name -> download command
    DOWNLOADS = SRA.downloads(ENA_SCRIPT)
    MAX_PARALLEL = int(DOWNLOAD.get("max_parallel") or 4)
    if MAX_PARALLEL < 1:
        raise ValueError("download.max_parallel must be at least 1.")
    CHECKSUM_RESOURCES = W.job_resources(CHECKSUMS)
except (OSError, ValueError) as err:
    raise WorkflowError(f"pipeline_sra: {err}")

# Limit the number of concurrent downloads. Each download uses one unit of
# this resource; the limit cannot be raised on the command line.
workflow.global_resources["ena_downloads"] = MAX_PARALLEL

wildcard_constraints:
    fastq=W.wildcard_choices(DOWNLOADS),


# Downloads and the summary run on the launching node: compute nodes have no
# internet access.
localrules: full, ena_download, report_checksums, clean_up


rule full:
    input:
        "README.md",
        "checksums.dir/failed_check_sums.txt",


rule ena_download:
    """Download one file with the command from the ENA script."""
    output:
        fastq="downloaded.dir/{fastq}",
        sentinel="downloaded.dir/.sentinel.{fastq}",
    params:
        command=lambda wildcards: DOWNLOADS[wildcards.fastq],
    log:
        "logs/ena_download/{fastq}.log",
    resources:
        ena_downloads=1,
    shell:
        """
        (cd downloaded.dir && {params.command}) > {log} 2>&1
        echo "$(date '+%Y-%m-%d %H:%M:%S')    downloaded {wildcards.fastq}" \
            > {output.sentinel}
        """


rule generate_md5:
    """Compute the MD5 checksum of one downloaded file."""
    input:
        "downloaded.dir/{fastq}",
    output:
        "checksums.dir/{fastq}.md5",
    threads: 1
    resources:
        **CHECKSUM_RESOURCES,
    shell:
        "md5sum {input} > {output}"


rule verify_md5:
    """Check one downloaded file against its MD5 checksum."""
    input:
        "checksums.dir/{fastq}.md5",
    output:
        "checksums.dir/.sentinel.{fastq}.md5",
    threads: 1
    resources:
        **CHECKSUM_RESOURCES,
    shell:
        "md5sum -c {input} > {output}"


rule report_checksums:
    """Collect the checksum results and write README.md."""
    input:
        downloads=expand("downloaded.dir/.sentinel.{fastq}", fastq=DOWNLOADS),
        checks=expand("checksums.dir/.sentinel.{fastq}.md5", fastq=DOWNLOADS),
    output:
        report="checksums.dir/report.txt",
        failed="checksums.dir/failed_check_sums.txt",
        readme="README.md",
    run:
        results = [Path(check).read_text() for check in input.checks]
        Path(output.report).write_text("".join(results))

        failed = [line for result in results
                  for line in result.splitlines(keepends=True)
                  if "OK" not in line]
        Path(output.failed).write_text("".join(failed))

        readme = [
            f"BioProject: {BIOPROJECT}",
            "Download pipeline run on: "
            + datetime.today().strftime("%Y-%m-%d"),
            "Download log:",
        ]
        readme += [Path(sentinel).read_text().rstrip("\n")
                   for sentinel in input.downloads]
        readme.append("")
        if failed:
            readme.append("failed check sums:")
            readme += [line.split(" ")[0] for line in failed]
        else:
            readme.append("all downloads passed md5 check sums")
        Path(output.readme).write_text("\n".join(readme) + "\n")


rule clean_up:
    """Delete the downloaded files and record the deletion in README.md.

    Not part of 'full': run it with 'ocms_toolkit sra full -- clean_up'.
    """
    input:
        readme="README.md",
        failed="checksums.dir/failed_check_sums.txt",
    output:
        touch("downloaded.dir/.sentinel.clean_up"),
    run:
        stamp = datetime.today().strftime("%Y-%m-%d %H:%M:%S")
        with open(input.readme, "a") as readme:
            for fastq in DOWNLOADS:
                path = Path("downloaded.dir", fastq)
                if path.exists():
                    path.unlink()
                    readme.write(f"{stamp}    deleting {fastq}\n")
